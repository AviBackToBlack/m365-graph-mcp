{
  "name": "m365-graph-mcp",
  "version": "0.0.0-private",
  "private": true,
  "description": "Read-only Microsoft Graph retrieval MCP for selected Microsoft 365 data surfaces.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "m365-graph-mcp": "dist/index.js",
    "m365-graph-bridge": "dist/bridge/main.js"
  },
  "files": [
    "dist/",
    "endpoints.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:release": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.release.json",
    "prepack": "npm run build:release",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src .github eslint.config.js package.json tsconfig.json tsconfig.release.json",
    "format:check": "prettier --check src .github eslint.config.js package.json tsconfig.json tsconfig.release.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
